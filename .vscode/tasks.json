{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Workstation Setup (Preview)",
      "type": "shell",
      "command": "pwsh",
      "args": [
        "-NoLogo",
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "setup-llm/scripts/setup.ps1",
        "-Client",
        "Both",
        "-WhatIf"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "focus": false
      },
      "problemMatcher": []
    },
    {
      "label": "Workstation Setup",
