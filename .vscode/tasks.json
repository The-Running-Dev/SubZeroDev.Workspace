  "inputs": [
    {
      "id": "conversationArchive",
      "type": "promptString",
      "description": "Absolute private archive path (existing AgentKit archive)"
    },
    {
      "id": "conversationRequest",
      "type": "promptString",
      "description": "Absolute private AgentKit request JSON path (matching task action)"
    },
    {
      "id": "conversationTaskArchive",
      "type": "promptString",
      "description": "Existing PRIVATE archive checkout (absolute path; no default)",
      "password": true
    },
    {
      "id": "conversationTaskRequest",
      "type": "promptString",
      "description": "Reviewed PRIVATE AgentKit request JSON (absolute path; selects source/action)",
      "password": true
    },
    {
      "id": "conversationTaskProject",
      "type": "promptString",
      "description": "Existing project checkout whose origin selects the memory namespace",
      "password": true
    }
  ]
}
