        "focus": false
      },
      "problemMatcher": []
    },
    {
      "label": "Conversation: Fork",
      "type": "process",
      "command": "node",
      "args": [
        "${workspaceFolder}/setup-llm/scripts/conversation-task.mjs",
        "--operation",
        "fork",
        "--archive-root",
        "${input:conversationArchive}",
        "--request-file",
        "${input:conversationRequest}"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "echo": false
      },
      "problemMatcher": []
    },
    {
      "label": "Conversation: Attach",
      "type": "process",
      "command": "node",
      "args": [
        "${workspaceFolder}/setup-llm/scripts/conversation-task.mjs",
