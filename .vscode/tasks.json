      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "focus": false,
        "echo": false,
        "showReuseMessage": false
      },
      "problemMatcher": [],
      "runOptions": {
        "instanceLimit": 1
      }
    },
    {
      "label": "Conversation: Attach (Opt-in)",
      "type": "process",
      "command": "node",
      "args": [
        "${workspaceFolder}/setup-llm/scripts/Invoke-ConversationTask.mjs",
        "--operation",
        "attach"
      ],
      "options": {
        "cwd": "${workspaceFolder}",
        "env": {
