        "cwd": "${workspaceFolder}"
      },
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "focus": false
      },
      "problemMatcher": []
    },
    {
      "label": "Workstation Setup + Memory/Context7/GitHub/Docker MCP",
      "dependsOrder": "sequence",
      "dependsOn": [
        "Workstation Setup",
        "MCP: Register Context7 (Codex)",
        "MCP: Register Memory (Codex)",
        "MCP: Register Docker (Codex)",
        "MCP: Register Context7 (Claude Code)",
        "MCP: Register Memory (Claude Code)",
        "MCP: Register Docker (Claude Code)"
      ],
      "problemMatcher": []
    },
    {
      "label": "AI Cluster Setup (Opt-in)",
      "type": "shell",
      "command": "pwsh",
      "args": [
        "-NoLogo",
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "setup-llm/scripts/setup-ai-cluster.ps1",
        "-InitializeEnv",
        "-InitializeLocalInferenceConfig",
        "-RunHeadlessConfigTest"
