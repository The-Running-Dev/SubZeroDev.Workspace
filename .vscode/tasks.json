      ],
      "options": {
        "cwd": "${workspaceFolder}",
        "env": {
          "WORKSPACE_CONVERSATION_ARCHIVE": "${input:conversationTaskArchive}",
          "WORKSPACE_CONVERSATION_REQUEST": "${input:conversationTaskRequest}"
