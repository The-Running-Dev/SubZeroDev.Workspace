        "reveal": "always",
        "panel": "shared",
        "focus": false
      },
      "problemMatcher": []
    },
    {
      "label": "MCP: Register Context7 (Claude Code)",
      "type": "shell",
      "command": "claude",
      "args": [
        "mcp",
        "add",
        "--scope",
        "user",
        "context7",
        "--",
        "npx",
        "-y",
        "@upstash/context7-mcp@latest"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "focus": false
      },
      "problemMatcher": []
    },
