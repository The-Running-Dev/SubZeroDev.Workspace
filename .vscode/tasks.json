    {
      "label": "MCP: Register Docker (Claude Code)",
      "type": "shell",
      "command": "claude",
      "args": [
        "mcp",
        "add",
        "--scope",
        "user",
        "docker",
        "--",
        "docker",
        "mcp",
        "gateway",
        "run"
