      "options": {
        "cwd": "${workspaceFolder}"
      },
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "focus": false
      },
      "problemMatcher": []
    },
    {
      "label": "MCP: Register Memory (Codex)",
      "type": "shell",
      "command": "codex",
      "args": [
        "mcp",
        "add",
        "memory",
        "--",
