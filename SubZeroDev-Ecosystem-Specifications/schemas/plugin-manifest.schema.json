{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.subzerodev.com/plugin-manifest.schema.json",
  "title": "SubZeroDev Plugin Manifest",
  "type": "object",
  "required": [
    "schemaVersion",
    "id",
    "name",
    "version",
    "commands",
    "runtimes"
  ],
  "properties": {
    "schemaVersion": {
      "type": "string"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+([.-][a-z0-9]+)*$"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string"
    },
    "commands": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "inputSchema": {
            "type": "string"
          },
          "outputSchema": {
            "type": "string"
          },
          "idempotent": {
            "type": "boolean"
          },
          "timeout": {
            "type": "string"
          }
        },
        "additionalProperties": true
      }
    },
    "runtimes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "type"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "type": {
            "enum": [
              "docker",
              "process",
              "dotnet",
              "node",
              "python",
              "powershell",
              "remote"
            ]
          }
        },
        "additionalProperties": true
      }
    },
    "secrets": {
      "type": "array"
    },
    "capabilities": {
      "type": "object"
    }
  },
  "additionalProperties": true
}